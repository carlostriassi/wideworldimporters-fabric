// src/semantic_model/dax_measures_retail_sales.dax
// ============================================================
// DAX measure library — compatible with Tabular Editor 3 DAX Script.
//
// AUTO-GENERATED by scripts/generate_dax_measures.py
// Generated: 2026-09-03 22:04:35
// Domain:    retail_sales
// Tables in model: dim_customer, dim_date, dim_salesperson, dim_security_user, dim_stock_item, fact_customer_transactions, fact_invoice_lines, fact_order_lines
//
// Re-running the script regenerates everything ABOVE the manual
// sentinel. Hand-written measures placed BELOW the sentinel are
// preserved across regenerations.
//
// ── MEASURE-NAME DISAMBIGUATION (manual fix, 2026) ──────────
// Power BI measure names must be UNIQUE across the whole model, not just
// within a table. The generator emitted identical names on multiple facts
// that share a source column, which caused Dataset_Import_FailedToImportDataset
// ("a Measure with the same name already exists"). The following families were
// renamed with a fact-specific qualifier so every name is globally unique:
//   • "Unit Price" family  → "Order Unit Price"   on fact_order_lines
//                           → "Invoice Unit Price" on fact_invoice_lines
//   • "Tax Amount" family  → "Invoice Tax Amount"  on fact_invoice_lines
//                           → "Cust Txn Tax Amount" on fact_customer_transactions
// NOTE: re-running generate_dax_measures.py will reintroduce the collisions —
// re-apply this disambiguation (or fix the generator) after any regeneration.
//
// ── DEPLOYMENT (Tabular Editor 3) ───────────────────────────
//   1. Open Tabular Editor 3
//   2. Connect to the Power BI semantic model in the Fabric workspace
//   3. View → Scripting → DAX Script
//   4. Paste the entire content of this file
//   5. Press F5 (Run Script on Model)
//   6. Save (Ctrl+S) to push changes to the live model
// ============================================================


// ── fact_order_lines: Reference date — anchor for time-intelligence measures

MEASURE 'fact_order_lines'[Last Order Lines Date] =
    LASTNONBLANK (
        'dim_date'[full_date],
        CALCULATE ( COUNTROWS ( fact_order_lines ) )
    )

// ── fact_order_lines: Volume

MEASURE 'fact_order_lines'[Total Order Lines] =
    COUNTROWS ( fact_order_lines )

MEASURE 'fact_order_lines'[Order Lines YTD] =
    VAR _refDate = [Last Order Lines Date]
    RETURN
        CALCULATE (
            [Total Order Lines],
            DATESBETWEEN (
                'dim_date'[full_date],
                DATE ( YEAR ( _refDate ), 1, 1 ),
                _refDate
            )
        )

MEASURE 'fact_order_lines'[Order Lines MTD] =
    VAR _refDate = [Last Order Lines Date]
    RETURN
        CALCULATE (
            [Total Order Lines],
            DATESBETWEEN (
                'dim_date'[full_date],
                EOMONTH ( _refDate, -1 ) + 1,
                _refDate
            )
        )

MEASURE 'fact_order_lines'[Total Order Lines LY] =
    VAR _refDate = [Last Order Lines Date]
    RETURN
        CALCULATE (
            [Total Order Lines],
            DATESBETWEEN (
                'dim_date'[full_date],
                DATE ( YEAR ( _refDate ) - 1, 1, 1 ),
                EDATE ( _refDate, -12 )
            )
        )

MEASURE 'fact_order_lines'[Order Lines YoY %] =
    DIVIDE (
        [Total Order Lines] - [Total Order Lines LY],
        [Total Order Lines LY],
        BLANK ()
    )

// ── fact_order_lines: Unit Price (disambiguated → "Order Unit Price")

MEASURE 'fact_order_lines'[Total Order Unit Price] =
    SUM ( fact_order_lines[unit_price] )

MEASURE 'fact_order_lines'[Avg Order Unit Price] =
    AVERAGE ( fact_order_lines[unit_price] )

MEASURE 'fact_order_lines'[Order Unit Price YTD] =
    VAR _refDate = [Last Order Lines Date]
    RETURN
        CALCULATE (
            [Total Order Unit Price],
            DATESBETWEEN (
                'dim_date'[full_date],
                DATE ( YEAR ( _refDate ), 1, 1 ),
                _refDate
            )
        )

