                DATE ( YEAR ( _refDate ) - 1, 1, 1 ),
                EDATE ( _refDate, -12 )
            )
        )

MEASURE 'fact_order_lines'[Order Unit Price YoY %] =
    DIVIDE (
        [Total Order Unit Price] - [Total Order Unit Price LY],
        [Total Order Unit Price LY],
        BLANK ()
    )

MEASURE 'fact_order_lines'[Order Unit Price 3M Rolling] =
    VAR _refDate = [Last Order Lines Date]
    RETURN
        CALCULATE (
            [Total Order Unit Price],
            DATESINPERIOD (
                'dim_date'[full_date],
                _refDate,
                -3,
                MONTH
            )
        )

