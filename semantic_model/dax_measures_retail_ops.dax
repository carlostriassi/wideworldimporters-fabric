// ── fact_purchase_order_lines: Reference date — anchor for time-intelligence measures

MEASURE 'fact_purchase_order_lines'[Last Purchase Order Lines Date] =
    LASTNONBLANK (
        'dim_date'[full_date],
        CALCULATE ( COUNTROWS ( fact_purchase_order_lines ) )
    )

// ── fact_purchase_order_lines: Volume

MEASURE 'fact_purchase_order_lines'[Total Purchase Order Lines] =
    COUNTROWS ( fact_purchase_order_lines )

MEASURE 'fact_purchase_order_lines'[Purchase Order Lines YTD] =
    VAR _refDate = [Last Purchase Order Lines Date]
    RETURN
        CALCULATE (
            [Total Purchase Order Lines],
            DATESBETWEEN (
                'dim_date'[full_date],
                DATE ( YEAR ( _refDate ), 1, 1 ),
                _refDate
            )
        )

MEASURE 'fact_purchase_order_lines'[Purchase Order Lines MTD] =
    VAR _refDate = [Last Purchase Order Lines Date]
    RETURN
        CALCULATE (
            [Total Purchase Order Lines],
            DATESBETWEEN (
                'dim_date'[full_date],
                EOMONTH ( _refDate, -1 ) + 1,
                _refDate
            )
        )

MEASURE 'fact_purchase_order_lines'[Total Purchase Order Lines LY] =
    VAR _refDate = [Last Purchase Order Lines Date]
    RETURN
        CALCULATE (
            [Total Purchase Order Lines],
            DATESBETWEEN (
                'dim_date'[full_date],
                DATE ( YEAR ( _refDate ) - 1, 1, 1 ),
                EDATE ( _refDate, -12 )
            )
        )

MEASURE 'fact_purchase_order_lines'[Purchase Order Lines YoY %] =
    DIVIDE (
        [Total Purchase Order Lines] - [Total Purchase Order Lines LY],
        [Total Purchase Order Lines LY],
        BLANK ()
    )

// ── fact_purchase_order_lines: Expected Unit Price Per Outer

MEASURE 'fact_purchase_order_lines'[Total Expected Unit Price Per Outer] =
    SUM ( fact_purchase_order_lines[expected_unit_price_per_outer] )

MEASURE 'fact_purchase_order_lines'[Avg Expected Unit Price Per Outer] =
    AVERAGE ( fact_purchase_order_lines[expected_unit_price_per_outer] )

MEASURE 'fact_purchase_order_lines'[Expected Unit Price Per Outer YTD] =
    VAR _refDate = [Last Purchase Order Lines Date]
    RETURN
        CALCULATE (
            [Total Expected Unit Price Per Outer],
            DATESBETWEEN (
                'dim_date'[full_date],
                DATE ( YEAR ( _refDate ), 1, 1 ),
                _refDate
            )
        )

MEASURE 'fact_purchase_order_lines'[Total Expected Unit Price Per Outer LY] =
    VAR _refDate = [Last Purchase Order Lines Date]
    RETURN
        CALCULATE (
            [Total Expected Unit Price Per Outer],
            DATESBETWEEN (
                'dim_date'[full_date],
                DATE ( YEAR ( _refDate ) - 1, 1, 1 ),
                EDATE ( _refDate, -12 )
            )
        )

MEASURE 'fact_purchase_order_lines'[Expected Unit Price Per Outer YoY %] =
    DIVIDE (
        [Total Expected Unit Price Per Outer] - [Total Expected Unit Price Per Outer LY],
        [Total Expected Unit Price Per Outer LY],
        BLANK ()
    )

MEASURE 'fact_purchase_order_lines'[Expected Unit Price Per Outer 3M Rolling] =
    VAR _refDate = [Last Purchase Order Lines Date]
    RETURN
        CALCULATE (
            [Total Expected Unit Price Per Outer],
            DATESINPERIOD (
                'dim_date'[full_date],
                _refDate,
                -3,
                MONTH
            )
        )

